# Copy this file to .env and fill in your values.
# cp .env.example .env

# ── Brave Search API ──────────────────────────────────────────────────────────
# Free tier: 2 000 queries / month  |  Sign up: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key_here

# ── Supabase (Stage 2 persistence + REST API) ────────────────────────────────
# Sign up free at https://supabase.com — create a project, then find these
# under Project Settings → API.
#
# SUPABASE_URL        — your project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_SERVICE_KEY — "service_role" secret key (scraper write access)
# SUPABASE_ANON_KEY   — "anon" public key (frontend read access, safe to expose)
#
# Leave blank to fall back to data/events.json (local development mode).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ── Google Sheets export (optional) ──────────────────────────────────────────
# Set to "true" to push results to a Google Sheet after each run.
# Requires credentials.json (OAuth) or service_account.json.
ENABLE_GOOGLE_SHEETS=false
